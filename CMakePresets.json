{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "native",
        "MATRIX_PRO_BUILD_TESTS": "ON",
        "MATRIX_PRO_BUILD_BENCHMARKS": "ON",
        "MATRIX_PRO_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (optimized library + benchmarks)"
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug (assertions on)"
    },
    {
      "name": "lib-only",
      "inherits": "base",
      "displayName": "Library only (no tests/benchmarks/examples)",
      "cacheVariables": {
        "MATRIX_PRO_BUILD_TESTS": "OFF",
        "MATRIX_PRO_BUILD_BENCHMARKS": "OFF",
        "MATRIX_PRO_BUILD_EXAMPLES": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "release-tests",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "unit",
      "inherits": "release-tests",
      "filter": {
        "include": {
          "label": "unit"
        }
      }
    },
    {
      "name": "integration",
      "inherits": "release-tests",
      "filter": {
        "include": {
          "label": "integration"
        }
      }
    }
  ]
}
